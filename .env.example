# Base de Datos
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://milojos:change_me_in_production@localhost:5433/milojos_dev

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@localhost:6379

# JWT
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Firebase / FCM
FCM_SERVER_KEY=your-fcm-server-key
FIREBASE_PROJECT_ID=milojos-app

# Google Play Billing (validar suscripciones)
GOOGLE_PLAY_PACKAGE_NAME=com.milojos.app
GOOGLE_PLAY_SERVICE_ACCOUNT=base64_encoded_service_account_json

# Mediasoup / WebRTC
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
SERVER_PUBLIC_IP=127.0.0.1
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100

# Mapbox
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# AWS S3 (fotos de alerta)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=milojos-alerts
AWS_REGION=us-east-1

# App Config
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Shake detector calibration
SHAKE_THRESHOLD_G=2.5
SHAKE_MIN_DURATION_MS=500
ALERT_RADIUS_METERS=500
MAX_FALSE_ALARMS_PER_HOUR=3
